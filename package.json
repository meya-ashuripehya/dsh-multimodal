{
  "name": "dsh-multimodal",
  "version": "0.1.0",
  "description": "DSH 多模态插件雏形：设置页（settings.section + ctx.settings 命名空间）与图片输出测试工具 mm_image_demo（attachments 持久图片 + tool.call.toolview 卡片）。",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "schemastery": "^3.18.0"
  },
  "license": "MIT"
}
